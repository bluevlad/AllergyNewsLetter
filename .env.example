# AllergyNewsLetter 환경 변수 설정
# 이 파일을 .env로 복사하여 사용하세요

# ===========================================
# 네이버 검색 API (필수)
# https://developers.naver.com 에서 발급
# ===========================================
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# ===========================================
# PubMed E-utilities API (권장)
# https://www.ncbi.nlm.nih.gov/account/settings/
# API 키 없이도 동작하나, Rate Limit이 낮음
# ===========================================
PUBMED_API_KEY=your_pubmed_api_key_here
PUBMED_EMAIL=your_email@example.com

# ===========================================
# Ollama 설정 (로컬 AI)
# ===========================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ===========================================
# Claude API (선택적 - 고품질 요약 필요 시)
# ===========================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ===========================================
# Gmail SMTP 설정
# Google 앱 비밀번호 사용 권장
# https://myaccount.google.com/apppasswords
# ===========================================
GMAIL_ADDRESS=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# ===========================================
# 데이터베이스 설정
# ===========================================
DATABASE_URL=sqlite:///./data/allergynewsletter.db

# ===========================================
# 스케줄러 설정
# ===========================================
CRAWL_HOUR=7
CRAWL_MINUTE=0
SEND_HOUR=8
SEND_MINUTE=0

# ===========================================
# 로깅 설정
# ===========================================
LOG_LEVEL=INFO
